# Clicky Windows environment variables.
# Copy this file to .env and fill in your values. Never commit .env to git.

# Anthropic API key (required for Phase 1 — Computer Use API beta is Anthropic-direct only)
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional overrides (defaults live in config.py):
# HOTKEY=alt+space                # Options: alt+space, ctrl+shift+space. NEVER ctrl+space (VS Code conflict).
# WHISPER_MODEL=base              # faster-whisper model: tiny, base, small, medium. Default: base.
# MODEL_ID=claude-sonnet-4-6      # Claude model ID for vision + Computer Use
# MEMORY_DIR=                     # Defaults to ~/.clicky-windows/memory/
