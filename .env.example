# Clicky Windows settings for running from source.
# Copy this file to .env and fill in what you use. Never commit .env.
# The installed app does not need this file: keys entered in Settings are
# kept in Windows Credential Manager.

# Listening and voice. One Cartesia key covers both.
# https://play.cartesia.ai
CARTESIA_API_KEY=

# AI model. One key is enough: Clicky uses the provider you have a key for.
# An OpenRouter key (sk-or-...) works in any of these three slots.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional
# LLM_PROVIDER=openai            # openai, anthropic, gemini or ollama
# STT_PROVIDER=cartesia          # cartesia, assemblyai or faster-whisper (local)
# TTS_PROVIDER=cartesia          # cartesia, elevenlabs or kokoro (local)
# ASSEMBLYAI_API_KEY=            # needed only for STT_PROVIDER=assemblyai
# ELEVENLABS_API_KEY=            # needed only for TTS_PROVIDER=elevenlabs
# ANNOTATION_MODE=off            # on: Clicky also circles, underlines and labels
# DEBUG_SCREENSHOTS=off          # on: keep screenshots in ~/.clicky-windows/debug/
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL_VISION=llava:7b
# CARTESIA_VOICE_ID=             # a different Cartesia voice
# MEMORY_DIR=                    # default ~/.clicky-windows/memory
# KB_DIR=                        # default ~/Documents/Clicky Wiki
