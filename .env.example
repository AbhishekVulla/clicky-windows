# Clicky Windows environment variables.
# Copy this file to .env and fill in your values. Never commit .env to git.

# Anthropic API key (required — Computer Use API beta is Anthropic-direct only)
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# AssemblyAI API key (required — streaming STT via u3-rt-pro WebSocket)
# Sign up at https://www.assemblyai.com/dashboard/signup — $50 in free credits, no credit card.
# After login, dashboard home shows "Your API Keys" card; copy the key.
ASSEMBLYAI_API_KEY=

# Cartesia API key (required — streaming TTS via Sonic-3 WebSocket)
# Sign up at https://play.cartesia.ai/sign-in — 20k free credits/month, no credit card.
# Left sidebar → API Keys → New Key → name it "clicky-windows-dev" → copy.
# Key format: starts with "sk_car_..."
CARTESIA_API_KEY=

# Optional overrides (defaults live in config.py):
# HOTKEY=ctrl+shift+space         # Phase 1 default. NEVER ctrl+space (VS Code IntelliSense conflict). Phase 1.5 may restore Alt+Space via Win32 RegisterHotKey subclass.
# MODEL_ID=claude-sonnet-4-6      # Claude model ID for vision + Computer Use. Phase 2 may add CLICKY_MODEL knob for Haiku 4.5 benchmarking.
# CARTESIA_VOICE_ID=              # Cartesia voice ID — default hardcoded in tts.py. Change to swap voice.
# MEMORY_DIR=                     # Defaults to ~/.clicky-windows/memory/
